ENVIRONMENT=development
APP_NAME=yisu-hotel-python
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DB_HOST=mysql
DB_PORT=3306
DB_USER=yisu
DB_PASSWORD=local-development-only
DB_NAME=yisu_hotel
DB_POOL_SIZE=5
DB_ECHO=false
REDIS_URL=redis://redis:6379/0
JWT_SECRET=local-development-only-change-before-production-2026
JWT_EXPIRES_IN=7d
JWT_ISSUER=yisu-hotel-local
JWT_AUDIENCE=yisu-hotel-clients
JWT_LEGACY_COMPATIBILITY_ENABLED=false
# JWT_LEGACY_COMPATIBILITY_UNTIL=2026-12-31T23:59:59+00:00
EMAIL_DELIVERY_ENABLED=false
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_USER=mailer@example.com
# EMAIL_PASSWORD=change-me
# EMAIL_FROM=mailer@example.com
# EMAIL_SECURE=true
# Use a dedicated random secret in production; do not reuse JWT_SECRET.
EMAIL_CODE_HASH_SECRET=local-email-code-hash-secret-change-before-production-2026
EMAIL_CODE_TTL_SECONDS=300
EMAIL_SEND_INTERVAL_SECONDS=60
EMAIL_CODE_FAIL_MAX_COUNT=5
EMAIL_CODE_LOCK_SECONDS=600
EMAIL_CODE_SINGLE_USE=true
LOGIN_FAIL_MAX_COUNT=5
LOGIN_FAIL_LOCK_SECONDS=600
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081"]
GRAPHQL_SCHEMA_PATH=../docs/refactor/p1/baseline/schema.graphql
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
